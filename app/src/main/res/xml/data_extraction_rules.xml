<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up and transfer the saved progress. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="hacksim_progress.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="hacksim_progress.xml" />
    </device-transfer>
</data-extraction-rules>
